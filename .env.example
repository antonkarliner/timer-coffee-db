# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenAI Configuration
# OpenAI API key used by the current system/operational workloads:
# coffee-label parsing, recipe-draft parsing and verification, translations,
# moderation, roaster enrichment, bean processing, and collection translation.
OPENAI_API_KEY_NON_PERSONAL=sk-your-key-here

# OpenAI API key used by roaster similarity and embedding maintenance:
# check-new-roaster and generate-roaster-embedding.
OPENAI_API_KEY=sk-your-key-here

# OpenAI model aliases. Only _shared/ai-models.ts reads these variables.
OPENAI_MODEL_BIG=gpt-5.6-sol
OPENAI_MODEL_MEDIUM=gpt-5.6-terra
OPENAI_MODEL_SMALL=gpt-5.6-luna
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_MODERATION=omni-moderation-latest

# Vercel AI Gateway Configuration
# Used by: parse-coffee-label (primary label-parsing tier, google/gemma-4-31b-it).
# OpenAI-compatible endpoint fronting many providers at list rates, no markup.
# Free tier: $5 of credits refreshing every 30 days across a subset of models.
# Buying credits ends the free allocation PERMANENTLY — do not top up to test.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key-here

# Z.ai (GLM) Configuration
Z_AI_API_KEY=your-z-ai-key-here
# Base URL for a coding-plan key; override for a pay-as-you-go key instead of editing code.
Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# TypeSafe AI "Jev" Configuration
# Used by: content-moderation and submit-yearly-wish as the PRIMARY text
# classifier (contact + harm in one batched call), and parse-coffee-label for
# roaster linking. Without this key both functions fall back to the Groq/omni
# chain below, which is slower and much less accurate on non-English text.
TYPESAFE_API_KEY=your-typesafe-key-here
# Kill switch: set to anything other than "true" to force the legacy fallback.
MODERATION_JEV_ENABLED=true
# Per-call deadline for the Jev moderation request, in ms. Held-out p95 was
# ~500 ms; a slower answer is better spent running the fallback.
MODERATION_JEV_TIMEOUT_MS=800

# Groq Configuration
# Used by: parse-coffee-label-groq (label parsing), content-moderation and
# submit-yearly-wish (FALLBACK obfuscated link/phone detection via gpt-oss-20b,
# reached only when Jev is unavailable)
GROQ_API_KEY=gsk_your-groq-key-here

# Google Gemini Configuration
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", "project_id": "your_project_id"}
GEMINI_PROJECT_ID=your_gemini_project_id
GEMINI_REGION=your_gemini_region

# App Store Connect Configuration (for version checking)
APPSTORE_ISSUER_ID=your_appstore_issuer_id
APPSTORE_KEY_ID=your_appstore_key_id
APPSTORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_content_here\n-----END PRIVATE KEY-----"

# Google Play Configuration (for version checking)
GOOGLE_PLAY_SERVICE_ACCOUNT={"type": "service_account", "project_id": "your_project_id"}
GOOGLE_PLAY_PACKAGE_NAME=com.your.package.name
# Bucket name only: omit gs:// and /stats/ratings/. Reuses GOOGLE_PLAY_SERVICE_ACCOUNT.
GOOGLE_PLAY_REPORTS_BUCKET=pubsite_prod_your_developer_account_id
# Optional. Defaults to Timer.Coffee's App Store app ID.
APP_STORE_APP_ID=6449322787

# OneSignal Configuration (for push notifications - being replaced by FCM)
# ONESIGNAL_APP_ID=your_onesignal_app_id
# ONESIGNAL_API_KEY=your_onesignal_api_key

# Firebase Cloud Messaging Configuration (replacing OneSignal)
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "your_firebase_project_id", "private_key_id": "your_private_key_id", "private_key": "-----BEGIN PRIVATE KEY-----\nyour_private_key_content_here\n-----END PRIVATE KEY-----\n", "client_email": "your-service-account@your-project-id.iam.gserviceaccount.com", "client_id": "your_client_id", "auth_uri": "https://accounts.google.com/o/oauth2/auth", "token_uri": "https://oauth2.googleapis.com/token"}

# Cron Job Secret for secure scheduled notification processing
CRON_JOB_SECRET=your_secure_random_string_here_at_least_32_characters

# Email Configuration (using Resend)
RESEND_API_KEY=your_resend_api_key
# Shared with website Vercel env; HMAC for signed client-IP header; >= 32 random chars.
WEBSITE_PROXY_SECRET=
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret
BLOG_SITE_URL=https://www.timer.coffee
BLOG_SENDER_EMAIL=Timer.Coffee Blog <noreply@timer.coffee>
ADMIN_EMAIL=your_admin_email@domain.com

# Google Services Configuration
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_PROGRAMMABLE_ENGINE_ID=your_google_search_engine_id
GEOCODING_API_KEY=your_geocoding_api_key
# Google Web Risk (uris:search) for the roaster-link-scan cron. Sent only in the
# X-Goog-Api-Key header. Without it the scan returns 500 and checks nothing.
GOOGLE_WEB_RISK_API_KEY=your_google_web_risk_api_key

# Feature Flags
ROASTER_EMAIL_ENABLED=true

# Security Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com,http://localhost:3000,http://localhost:8080
DOMAIN=yourdomain.com

# Redis Configuration for rate limiting (optional but recommended)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TTL=3600

# Monitoring and Error Tracking
MONITORING_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ERROR_REPORTING_EMAIL=errors@yourdomain.com
LOG_LEVEL=info

# FCM Configuration
FCM_BATCH_SIZE=500
TOKEN_MAX_AGE_DAYS=90
MAX_REQUEST_SIZE=1048576
SCHEDULED_NOTIFICATIONS_BATCH=100

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DAILY_NOTIFICATION_LIMIT=50
ANONYMOUS_RATE_LIMIT=10

# Note: Never commit real API keys or secrets to version control!
# Copy this file to .env.local and fill in your actual values for local development.
